# URL del backend por defecto en desarrollo local. En producción (Vercel u
# otro hosting), define VITE_API_BASE_URL apuntando al backend real, p. ej.:
#   VITE_API_BASE_URL=https://api.alectours.com
# Sin esta variable definida, el frontend usa http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000
