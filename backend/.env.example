# Backend Configuration - .env.example
# Copia este archivo a .env y llena los valores vacíos.
#
# NOTA: docker-compose.yml (desarrollo local) ya carga este archivo
# directamente como valor por defecto, así que `docker compose up --build`
# funciona sin crear un .env a mano. Si creas backend/.env, sus valores
# sobreescriben a los de aquí (útil para probar SMTP real, un SECRET_KEY
# propio, etc. sin tocar este archivo versionado).

# ============================================================================
# BASE DE DATOS
# ============================================================================
DATABASE_URL=postgresql+psycopg2://admin:admin123@postgres:5432/alektours_db

# ============================================================================
# CACHÉ (REDIS)
# ============================================================================
# El servicio "redis" ya viene definido en docker-compose.yml — este valor
# es el que app/core/cache.py usa por defecto si no se define nada, así que
# en desarrollo con Docker no hace falta tocarlo. Documentado aquí para que
# no falte si se corre el backend fuera de docker-compose o en producción.
REDIS_URL=redis://redis:6379/0

# ============================================================================
# AUTENTICACIÓN JWT
# ============================================================================
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev_secret_key_minimum_32_characters_for_development_only_change_in_production

# Algoritmo de encriptación
ALGORITHM=HS256

# Expiración de tokens en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# CONFIGURACIÓN DE EMAIL (SMTP)
# ============================================================================
# Para desarrollo: usar Mailpit (puerto 1025)
# Para producción: usar Gmail, SendGrid, AWS SES, etc.

# Usuario/email SMTP
MAIL_USERNAME=

# Contraseña SMTP (app password si usas Gmail)
MAIL_PASSWORD=

# Email de origen
MAIL_FROM=noreply@alectours.com

# Puerto SMTP
# - Mailpit: 1025
# - Gmail: 587 (TLS) o 465 (SSL)
# - SendGrid: 587
MAIL_PORT=1025

# Servidor SMTP
# - Mailpit: mailpit
# - Gmail: smtp.gmail.com
# - SendGrid: smtp.sendgrid.net
MAIL_SERVER=mailpit

# Nombre visible del remitente
MAIL_FROM_NAME=AlecTours

# Usar STARTTLS (requerido en algunos servidores)
MAIL_STARTTLS=False

# Usar SSL/TLS (requerido en algunos servidores)
MAIL_SSL_TLS=False

# ============================================================================
# FRONTEND Y CORS (Fase 0 del plan de mejora — antes hardcodeados a localhost)
# ============================================================================
# Dominio real del frontend en producción (Vercel), usado en los links de
# verificación de correo y de reset de contraseña. Sin definir, se usa
# http://localhost:5173 (dev).
# FRONTEND_URL=https://tu-dominio-real.vercel.app

# Orígenes adicionales permitidos por CORS, separados por coma. Los de
# localhost siempre están permitidos aparte, para no romper el desarrollo
# local. Sin definir, solo se permite localhost (así queda hoy en dev).
# CORS_ORIGINS=https://tu-dominio-real.vercel.app

# ============================================================================
# OBSERVABILIDAD: SENTRY (monitoreo de errores)
# ============================================================================
# DSN de tu proyecto en Sentry (https://sentry.io o self-hosted). Si se
# deja vacío, el backend funciona igual pero sin reportar errores a Sentry —
# así es como queda desactivado en desarrollo/CI.
# Formato: https://clave@ingest.sentry.io/1234567
# SENTRY_DSN=
#
# Fracción de transacciones (trazas con datos de rendimiento) a enviar, 0-1.
# 0 = solo errores, sin tracing. En producción se suele usar ~0.1 (10%).
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ============================================================================
# CONFIGURACIÓN DE DESARROLLO
# ============================================================================
# DEBUG=True
# LOG_LEVEL=DEBUG

# ============================================================================
# NOTAS DE SEGURIDAD
# ============================================================================
# ⚠️  NUNCA commitear este archivo a Git
# ✓  Incluido en .gitignore
# ✓  Crear .env.example sin valores sensibles (para documentación)
# ✓  En producción, usar variables de entorno del servidor/contenedor
# ✓  Generar SECRET_KEY fuerte para producción
